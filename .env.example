# Copy to .env and fill in before running locally.

# REQUIRED: bot token from @BotFather
BOT_TOKEN=123456789:your-token-here

# Deployment mode: "webhook" (PaaS default) or "polling" (local dev)
MODE=polling

# Webhook mode only: public base URL of this service
# (Render sets RENDER_EXTERNAL_URL automatically; use WEBHOOK_URL elsewhere)
#WEBHOOK_URL=https://my-app.onrender.com
#WEBHOOK_PATH=/telegram/webhook

# Strongly recommended in webhook mode: shared secret Telegram must echo back
#WEBHOOK_SECRET=change-me-to-a-long-random-string

# Optional
#LOG_LEVEL=INFO
#PORT=8000
